[Unit]
Description=Army RMRP portal API
After=network.target postgresql.service
[Service]
User=army
WorkingDirectory=/opt/army
EnvironmentFile=/opt/army/.env
ExecStart=/usr/bin/node /opt/army/server/start.mjs
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/army/media
UMask=0077
[Install]
WantedBy=multi-user.target
